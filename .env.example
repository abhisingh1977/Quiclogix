# Quiclogix Solutions — Environment Variables Example
# Copy this file to .env.local for local development.
# WARNING: Never commit .env, .env.local, or real production secrets to version control.

# ==============================================================================
# Client-side Variables (Exposed in browser bundle via Vite)
# ==============================================================================
# Local Supabase default: http://127.0.0.1:54321
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Public Key (Safe for browser client, RLS-enforced)
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Client environment identifier ('development' | 'staging' | 'production')
VITE_APP_ENV="development"

# ==============================================================================
# Server-side Only Variables (DO NOT prefix with VITE_)
# NEVER expose these to the frontend client application!
# ==============================================================================
# Supabase Service Role Key (Bypasses RLS - used only in trusted Edge Functions & admin scripts)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# PostgreSQL Direct Connection String (Used for migrations and direct CLI operations)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# JWT Secret for token signing and verification
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Payment Gateway Webhook Secret (Pending Decision O-03: Payment Provider Selection)
# Razorpay / Cashfree webhook signature verification
PAYMENT_WEBHOOK_SECRET="your-payment-provider-webhook-secret"
